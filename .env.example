PORT=8080
HOST=127.0.0.1

# Required for any non-local bind such as HOST=0.0.0.0.
ADMIN_TOKEN=change-this-for-remote-admin
API_TOKEN=change-this-for-remote-api

# Comma-separated exact origins for remote/static dashboards.
# Localhost origins are allowed by the default CORS_ORIGIN_REGEX.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$

# Per client/token/path. Set to 0 only for trusted local-only testing.
RATE_LIMIT_PER_MINUTE=120

# Only enable behind a reverse proxy that overwrites X-Forwarded-For itself.
# Otherwise any caller can spoof the header and get a fresh rate-limit bucket per request.
TRUST_PROXY_HEADERS=0

# Channels a single request may try before giving up.
MAX_ROUTE_ATTEMPTS=3

# Allow a claude-* request to be answered by, say, an OpenAI channel when no Claude channel
# exists. Off by default: a wrong-provider answer is worse for an agent than a clear error.
CROSS_PROVIDER_FALLBACK=0

# Anthropic requires max_tokens; OpenAI-dialect callers often omit it. 4096 is accepted by
# every current model. Raise it if the models you use allow a larger output.
ANTHROPIC_DEFAULT_MAX_TOKENS=4096

# A channel is parked for QUOTA_COOLDOWN_SECONDS once the provider reports less headroom
# than these thresholds. Token and request budgets are tracked separately because "50
# requests left" is healthy while "50 tokens left" is not.
QUOTA_EXHAUSTED_THRESHOLD=100
QUOTA_EXHAUSTED_REQUESTS=1
QUOTA_COOLDOWN_SECONDS=60
# Streaming responses expose no rate-limit headers, so a reading older than this is ignored
# rather than parking a streaming-only channel forever.
QUOTA_STALE_SECONDS=300

# How long a web-session channel may spend waiting for the page to finish answering, and how
# many unchanged polls mean a streamed answer has settled.
WEB_RESPONSE_TIMEOUT_MS=120000
WEB_STREAM_SETTLE_POLLS=8

# Number of recent sanitized diagnostic events kept in memory.
DIAGNOSTIC_EVENT_LIMIT=200

# Set DEBUG_ERRORS=1 only while debugging packaging issues locally.
DEBUG_ERRORS=0
